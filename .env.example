# Skopiuj ten plik jako ".env" i uzupelnij danymi

# Port, na ktorym dziala aplikacja
PORT=3000

# Sekret sesji - wpisz dowolny losowy ciag znakow
SESSION_SECRET=zmien_to_na_losowy_ciag_znakow_123456

# Nazwa firmy (wyswietlana na protokolach PDF)
COMPANY_NAME=Nazwa Twojej Firmy

# Konfiguracja SMTP do wysylki protokolow PDF mailem
# Przyklad dla Office365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
# Przyklad dla Gmail (wymaga hasla aplikacji, nie zwyklego hasla):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CC=
