<%- include('../partials/header', { title: 'Urządzenia' }) %>
<div class="page-header">
  <h1>Urządzenia</h1>
  <a href="/urzadzenia/nowy" class="btn">+ Dodaj urządzenie</a>
</div>

<form class="search-bar" method="GET" action="/urzadzenia">
  <input type="text" name="q" placeholder="Szukaj: nazwa, model, S/N, numer inwentarzowy..." value="<%= q %>">

  <select name="category_id">
    <option value="">Wszystkie kategorie</option>
    <% categories.forEach(cat => { %>
      <option value="<%= cat.id %>" <%= category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
    <% }) %>
  </select>

  <select name="status">
    <option value="">Wszystkie statusy</option>
    <option value="dostepny" <%= status==='dostepny'?'selected':'' %>>Dostępny</option>
    <option value="wydany" <%= status==='wydany'?'selected':'' %>>Wydany</option>
    <option value="serwis" <%= status==='serwis'?'selected':'' %>>W serwisie</option>
    <option value="zezlomowany" <%= status==='zezlomowany'?'selected':'' %>>Zezłomowany</option>
    <option value="utylizacja" <%= status==='utylizacja'?'selected':'' %>>Utylizacja</option>
  </select>

  <select name="location_id">
    <option value="">Wszystkie lokalizacje</option>
    <% locations.forEach(loc => { %>
      <option value="<%= loc.id %>" <%= location_id == loc.id ? 'selected' : '' %>><%= loc.name %></option>
    <% }) %>
  </select>

  <select name="department">
    <option value="">Wszystkie działy</option>
    <% ['Hoste', 'Purchase', 'Marketing', 'HR', 'Mechanic', 'electric', 'Packing', 'Accounting', 'Admin', 'Production', 'Planning', 'BHP', 'QC', 'Węgry', 'IT', 'Club', 'Office', 'Security', 'Logistic'].forEach(departmentName => { %>
      <option value="<%= departmentName %>" <%= department === departmentName ? 'selected' : '' %>><%= departmentName %></option>
    <% }) %>
  </select>
  <select name="employee_id">
    <option value="">Wszyscy pracownicy</option>
    <% employees.forEach(employee => { %>
      <option value="<%= employee.id %>" <%= employee_id == employee.id ? 'selected' : '' %>><%= employee.person %></option>
    <% }) %>
  </select>
  <button class="btn btn-secondary" type="submit">Filtruj</button>
</form>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Urządzenie</th>
        <th>Kategoria</th>
        <th>S/N</th>
        <th>Lokalizacja</th>
        <th>Dział</th>
        <th>Pracownik</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (devices.length === 0) { %>
        <tr><td colspan="8" class="empty-state">Brak urządzeń spełniających kryteria.</td></tr>
      <% } %>
      <% devices.forEach(d => { %>
        <tr class="clickable-row" data-href="/urzadzenia/<%= d.id %>" tabindex="0" role="link">
          <td><a href="/urzadzenia/<%= d.id %>"><%= d.device || d.model || '(bez nazwy)' %></a></td>
          <td><%= d.category_name || '-' %></td>
          <td><%= d.serial_number || '-' %></td>
          <td><%= d.location_name || d.assigned_to_location || '-' %></td>
          <td><%= d.department || '-' %></td>
          <td><%= d.assigned_employee_name || '-' %></td>
          <td>
            <span class="badge badge-<%= d.status %>"><%= d.status %></span>
            <% if (!d.active) { %><span class="badge badge-inactive">Nieaktywne</span><% } %>
          </td>
            <td class="device-actions">
            <% if (d.status === 'wydany' && d.assignment_id) { %>
              <a href="/protokoly/zdanie/nowy?assignment_id=<%= d.assignment_id %>" class="btn btn-sm btn-danger">Zdaj</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

<script>
  document.querySelectorAll('.clickable-row').forEach(row => {
    row.addEventListener('click', event => {
      if (event.target.closest('a, button, input, select, textarea')) return;
      window.location.href = row.dataset.href;
    });
    row.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      window.location.href = row.dataset.href;
    });
  });
</script>
