<%- include('../partials/header', { title: device.id ? 'Edytuj urządzenie' : 'Nowe urządzenie' }) %>
<div class="page-header"><h1><%= device.id ? 'Edytuj urządzenie' : 'Nowe urządzenie' %></h1></div>

<div class="card">
  <form method="POST" action="<%= action %>" class="form-grid">
    <div class="field">
      <label>Kategoria</label>
      <select name="category_id" id="category_id" required>
        <option value="">Wybierz kategorię</option>
        <% categories.forEach(category => { %>
          <option value="<%= category.id %>" data-slug="<%= category.slug %>" <%= device.category_id == category.id ? 'selected' : '' %>><%= category.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field device-name-field">
      <label>Nazwa / opis urządzenia</label>
      <input type="text" name="device" value="<%= device.device || '' %>">
    </div>
    <div class="field">
      <label>Producent</label>
      <input type="text" name="manufacturer" value="<%= device.manufacturer || '' %>">
    </div>
    <div class="field monitor-field">
      <label>Model</label>
      <input type="text" name="model" value="<%= device.model || '' %>">
    </div>
    <div class="field">
      <label>Numer inwentarzowy</label>
      <input type="text" name="inventory_number" value="<%= device.inventory_number || '' %>">
    </div>
    <div class="field">
      <label id="serial-label">Serial NR / Service Tag</label>
      <input type="text" name="serial_number" value="<%= device.serial_number || '' %>">
    </div>
    <div class="field laptop-field">
      <label>Computer Name</label>
      <input type="text" name="computer_name" value="<%= device.computer_name || '' %>">
    </div>
    <div class="field laptop-field">
      <label>Domena</label>
      <input type="text" name="domena" value="<%= device.domena || '' %>">
    </div>
    <div class="field">
      <label>Lokalizacja</label>
      <select name="location_id">
        <option value="">Wybierz lokalizację</option>
        <% locations.forEach(location => { %>
          <option value="<%= location.id %>" <%= device.location_id == location.id ? 'selected' : '' %>><%= location.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field printer-field">
      <label>Adres IP</label>
      <input type="text" name="ip_address" placeholder="192.168.1.100" value="<%= device.ip_address || '' %>">
    </div>
    <div class="field laptop-field">
      <label for="department">Dział / departament</label>
      <select name="department" id="department">
        <option value="">Wybierz dział</option>
        <% ['Hoste', 'Purchase', 'Marketing', 'HR', 'Mechanic', 'electric', 'Packing', 'Accounting', 'Admin', 'Production', 'Planning', 'BHP', 'QC', 'Węgry', 'IT', 'Club', 'Office', 'Security', 'Logistic'].forEach(departmentName => { %>
          <option value="<%= departmentName %>" <%= device.department === departmentName ? 'selected' : '' %>><%= departmentName %></option>
        <% }) %>
      </select>
    </div>
    <div class="field laptop-field">
      <label>Pomieszczenie / sala</label>
      <input type="text" name="room" value="<%= device.room || '' %>">
    </div>
    <div class="field laptop-field laptop-hidden-field">
      <label>MAC</label>
      <input type="text" name="mac" value="<%= device.mac || '' %>">
    </div>
    <div class="field simple-device-hidden-field">
      <label>VPN</label>
      <input type="text" name="vpn" value="<%= device.vpn || '' %>">
    </div>
    <div class="field simple-device-hidden-field">
      <label>VNC</label>
      <input type="text" name="vnc" value="<%= device.vnc || '' %>">
    </div>
    <div class="field simple-device-hidden-field">
      <label>AnyDesk</label>
      <input type="text" name="anydesk" value="<%= device.anydesk || '' %>">
    </div>
    <div class="field">
      <label>Data zakupu</label>
      <input type="date" name="data_zakupu" value="<%= device.data_zakupu || '' %>">
    </div>
    <div class="field simple-device-hidden-field laptop-hidden-field">
      <label>Data końca gwarancji</label>
      <input type="date" name="warranty_end_date" value="<%= device.warranty_end_date || '' %>">
    </div>
    <div class="field full">
      <label>Uwagi / opis</label>
      <textarea name="notes" rows="3"><%= device.notes || '' %></textarea>
    </div>
    <div class="field full">
      <label>Info</label>
      <textarea name="info" rows="3"><%= device.info || '' %></textarea>
    </div>
    <div class="field full form-actions">
      <button class="btn" type="submit">Zapisz</button>
      <a href="/urzadzenia" class="btn btn-secondary">Anuluj</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>

<script>
  const categorySelect = document.getElementById('category_id');
  const serialLabel = document.getElementById('serial-label');
  const laptopFields = document.querySelectorAll('.laptop-field');
  const laptopHiddenFields = document.querySelectorAll('.laptop-hidden-field');
  const deviceNameField = document.querySelector('.device-name-field');
  const simpleDeviceHiddenFields = document.querySelectorAll('.simple-device-hidden-field');
  const printerFields = document.querySelectorAll('.printer-field');

  function updateCategoryFields() {
    const slug = categorySelect.options[categorySelect.selectedIndex]?.dataset.slug;
    const isMonitor = slug === 'monitor';
    const isSimpleDevice = ['monitor', 'router', 'serwer', 'switch', 'drukarka'].includes(slug);
    const isPrinter = slug === 'drukarka';
    const isLaptop = slug === 'laptop';
    laptopFields.forEach(field => { field.hidden = isSimpleDevice; });
    laptopHiddenFields.forEach(field => { field.hidden = isLaptop; });
    deviceNameField.hidden = isLaptop;
    simpleDeviceHiddenFields.forEach(field => { field.hidden = isSimpleDevice; });
    printerFields.forEach(field => { field.hidden = !isPrinter; });
    serialLabel.textContent = isMonitor ? 'ServiceTag' : 'Serial NR / Service Tag';
  }

  categorySelect.addEventListener('change', updateCategoryFields);
  updateCategoryFields();
</script>
