<%- include('partials/header', { title: 'Raporty' }) %>
<div class="page-header">
  <h1>Raporty</h1>
</div>

<form class="search-bar" method="GET" action="/raporty">
  <select name="department">
    <option value="">Wszystkie działy</option>
    <% departments.forEach(item => { %>
      <option value="<%= item.department %>" <%= filters.department === item.department ? 'selected' : '' %>><%= item.department %></option>
    <% }) %>
  </select>

  <select name="location_id">
    <option value="">Wszystkie lokalizacje</option>
    <% locations.forEach(item => { %>
      <option value="<%= item.id %>" <%= filters.location_id == item.id ? 'selected' : '' %>><%= item.name %></option>
    <% }) %>
  </select>

  <select name="category_id">
    <option value="">Wszystkie kategorie</option>
    <% categories.forEach(item => { %>
      <option value="<%= item.id %>" <%= filters.category_id == item.id ? 'selected' : '' %>><%= item.name %></option>
    <% }) %>
  </select>

  <select name="status">
    <option value="">Wszystkie statusy</option>
    <option value="dostepny" <%= filters.status === 'dostepny' ? 'selected' : '' %>>Dostępny</option>
    <option value="wydany" <%= filters.status === 'wydany' ? 'selected' : '' %>>Wydany</option>
    <option value="serwis" <%= filters.status === 'serwis' ? 'selected' : '' %>>W serwisie</option>
    <option value="zezlomowany" <%= filters.status === 'zezlomowany' ? 'selected' : '' %>>Zezłomowany</option>
    <option value="utylizacja" <%= filters.status === 'utylizacja' ? 'selected' : '' %>>Utylizacja</option>
  </select>

  <button class="btn btn-secondary" type="submit">Filtruj</button>
  <a href="/raporty" class="btn btn-secondary">Wyczyść</a>
</form>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px;">
  <div class="card">
    <div class="section-title" style="margin-top:0;">Pracownicy i przypisania</div>
    <table>
      <thead>
        <tr>
          <th>Pracownik</th>
          <th>Dział</th>
          <th>Urządzenia</th>
        </tr>
      </thead>
      <tbody>
        <% if (employeeReport.length === 0) { %>
          <tr><td colspan="3" class="empty-state">Brak danych.</td></tr>
        <% } %>
        <% employeeReport.forEach(item => { %>
          <tr>
            <td><%= item.person %><br><a href="/urzadzenia?employee_id=<%= item.id %>">Pokaż urządzenia</a></td>
            <td><%= item.department || '-' %></td>
            <td><%= item.device_count %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="section-title" style="margin-top:0;">Lokalizacje</div>
    <table>
      <thead>
        <tr>
          <th>Lokalizacja</th>
          <th>Typ</th>
          <th>Urządzenia</th>
        </tr>
      </thead>
      <tbody>
        <% if (locationReport.length === 0) { %>
          <tr><td colspan="3" class="empty-state">Brak danych.</td></tr>
        <% } %>
        <% locationReport.forEach(item => { %>
          <tr>
            <td><%= item.location_name %><br><a href="/urzadzenia?location_id=<%= item.location_id %>">Pokaż urządzenia</a></td>
            <td><%= item.type %></td>
            <td><%= item.device_count %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card" style="grid-column: 1 / -1;">
    <div class="section-title" style="margin-top:0;">Działy</div>
    <table>
      <thead>
        <tr>
          <th>Dział</th>
          <th>Urządzeń</th>
        </tr>
      </thead>
      <tbody>
        <% if (departmentReport.length === 0) { %>
          <tr><td colspan="2" class="empty-state">Brak danych.</td></tr>
        <% } %>
        <% departmentReport.forEach(item => { %>
          <tr>
            <td><%= item.department %><br><a href="/urzadzenia?department=<%= encodeURIComponent(item.department) %>">Pokaż urządzenia</a></td>
            <td><%= item.device_count %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
