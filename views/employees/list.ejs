<%- include('../partials/header', { title: 'Pracownicy' }) %>
<div class="page-header">
  <h1>Pracownicy</h1>
  <a href="/pracownicy/nowy" class="btn">+ Dodaj pracownika</a>
</div>

<form class="search-bar" method="GET" action="/pracownicy">
  <input type="text" name="q" placeholder="Szukaj: osoba, dział, linia..." value="<%= q %>">
  <button class="btn btn-secondary" type="submit">Filtruj</button>
</form>

<div class="table-wrap">
  <table>
    <thead><tr><th>Osoba</th><th>Dział</th><th>Linia</th><th>E-mail</th><th></th></tr></thead>
    <tbody>
      <% if (employees.length === 0) { %><tr><td colspan="5" class="empty-state">Brak pracowników.</td></tr><% } %>
      <% employees.forEach(e => { %>
        <tr>
          <td><a href="/pracownicy/<%= e.id %>"><%= e.person %></a></td>
          <td><%= e.department || '-' %></td>
          <td><%= e.line || '-' %></td>
          <td><%= e.email || '-' %></td>
          <td><a href="/pracownicy/<%= e.id %>/edytuj" class="btn btn-sm btn-secondary">Edytuj</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
