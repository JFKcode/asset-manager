<%- include('../partials/header', { title: employee.person }) %>
<div class="page-header">
  <h1><%= employee.person %></h1>
  <a href="/pracownicy/<%= employee.id %>/edytuj" class="btn btn-secondary">Edytuj</a>
</div>

<div class="card">
  <div class="detail-grid">
    <div class="item"><div class="k">Dział</div><div class="v"><%= employee.department || '-' %></div></div>
    <div class="item"><div class="k">Linia</div><div class="v"><%= employee.line || '-' %></div></div>
    <div class="item"><div class="k">E-mail</div><div class="v"><%= employee.email || '-' %></div></div>
  </div>
  <% if (employee.info) { %><p class="muted" style="margin-top:14px;"><%= employee.info %></p><% } %>
</div>

<div class="section-title">Przypisany / historyczny sprzęt</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Urządzenie</th><th>S/N</th><th>Data wydania</th><th>Data zdania</th><th>Status</th></tr></thead>
    <tbody>
      <% if (assignments.length === 0) { %><tr><td colspan="5" class="empty-state">Brak historii.</td></tr><% } %>
      <% assignments.forEach(a => { %>
        <tr>
          <td><a href="/urzadzenia/<%= a.device_id %>"><%= a.device || '-' %></a></td>
          <td><%= a.serial_number || '-' %></td>
          <td><%= a.data_wydania || '-' %></td>
          <td><%= a.data_zdania || '-' %></td>
          <td><span class="badge badge-<%= a.status %>"><%= a.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
