<%- include('../partials/header', { title: 'Protokoły' }) %>
<div class="page-header">
  <h1>Protokoły</h1>
  <div style="display:flex; gap:8px;">
    <a href="/protokoly/wydanie/nowy" class="btn">+ Wydanie</a>
    <a href="/protokoly/zdanie/nowy" class="btn btn-secondary">+ Zdanie</a>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Data</th><th>Typ</th><th>Pracownik</th><th>Urządzenie</th><th>E-mail</th><th>Status maila</th><th></th></tr></thead>
    <tbody>
      <% if (protocols.length === 0) { %><tr><td colspan="7" class="empty-state">Brak protokołów.</td></tr><% } %>
      <% protocols.forEach(p => { %>
        <tr class="clickable-row" data-href="/protokoly/<%= p.id %>/pdf" tabindex="0" role="link">
          <td class="muted"><%= p.signed_at %></td>
          <td><span class="badge badge-<%= p.type === 'wydanie' ? 'wydany' : 'dostepny' %>"><%= p.type %></span></td>
          <td><%= p.person %></td>
          <td><%= p.device || '-' %> <span class="muted">(<%= p.serial_number || '-' %>)</span></td>
          <td class="muted"><%= p.emailed_to || '-' %></td>
          <td><span class="badge badge-<%= p.email_status || 'not_sent' %>"><%= p.email_status || 'not_sent' %></span></td>
          <td class="protocol-actions">
            <a href="/protokoly/<%= p.id %>/pdf" target="_blank" class="btn btn-sm btn-secondary">PDF</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

<script>
  document.querySelectorAll('.clickable-row').forEach(row => {
    row.addEventListener('click', event => {
      if (event.target.closest('a, button, input, select, textarea')) return;
      window.open(row.dataset.href, '_blank');
    });
    row.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      window.open(row.dataset.href, '_blank');
    });
  });
</script>
