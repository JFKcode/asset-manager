<%- include('partials/header', { title: 'Pulpit' }) %>
<div class="page-header"><h1>Pulpit</h1></div>

<div class="stat-grid">
  <a class="stat-card stat-link" href="/urzadzenia"><div class="num"><%= counts.total %></div><div class="label">Urządzenia łącznie</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?status=dostepny"><div class="num"><%= counts.dostepny %></div><div class="label">Dostępne</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?status=wydany"><div class="num"><%= counts.wydany %></div><div class="label">Wydane</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?status=serwis"><div class="num"><%= counts.serwis %></div><div class="label">W serwisie</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?status=zezlomowany"><div class="num"><%= counts.zezlomowany %></div><div class="label">Zezłomowane</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?status=utylizacja"><div class="num"><%= counts.utylizacja %></div><div class="label">Utylizacja</div></a>
  <a class="stat-card stat-link" href="/pracownicy"><div class="num"><%= counts.employees %></div><div class="label">Pracownicy</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?category_id=<%= categoryBreakdown.find(item => item.category_slug === 'laptop')?.category_id || '' %>"><div class="num"><%= counts.laptops %></div><div class="label">Laptopy</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?category_id=<%= categoryBreakdown.find(item => item.category_slug === 'monitor')?.category_id || '' %>"><div class="num"><%= counts.monitors %></div><div class="label">Monitory</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?category_id=<%= categoryBreakdown.find(item => item.category_slug === 'drukarka')?.category_id || '' %>"><div class="num"><%= counts.printers %></div><div class="label">Drukarki</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?category_id=<%= categoryBreakdown.find(item => item.category_slug === 'serwer')?.category_id || '' %>"><div class="num"><%= counts.servers %></div><div class="label">Serwery</div></a>
  <a class="stat-card stat-link" href="/urzadzenia?category_id=<%= categoryBreakdown.find(item => item.category_slug === 'switch')?.category_id || '' %>"><div class="num"><%= counts.switches %></div><div class="label">Switche</div></a>
</div>

<div class="card">
  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <a href="/protokoly/wydanie/nowy" class="btn">+ Wydaj sprzęt</a>
    <a href="/protokoly/zdanie/nowy" class="btn btn-secondary">+ Przyjmij zwrot</a>
    <a href="/urzadzenia/nowy" class="btn btn-secondary">+ Dodaj urządzenie</a>
    <a href="/pracownicy/nowy" class="btn btn-secondary">+ Dodaj pracownika</a>
  </div>
</div>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:20px; margin-top:20px;">
  <div class="card">
    <div class="section-title" style="margin-top:0;">Kategorie urządzeń</div>
    <table>
      <thead><tr><th>Kategoria</th><th>Ilość</th></tr></thead>
      <tbody>
        <% categoryBreakdown.forEach(item => { %>
          <tr>
            <td><a href="/urzadzenia?category_id=<%= item.category_id %>"><%= item.category %></a></td>
            <td><a href="/urzadzenia?category_id=<%= item.category_id %>"><%= item.total %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="section-title" style="margin-top:0;">Lokalizacje</div>
    <table>
      <thead><tr><th>Lokalizacja</th><th>Ilość</th></tr></thead>
      <tbody>
        <% locationBreakdown.forEach(item => { %>
          <tr>
            <td><a href="/urzadzenia?location_id=<%= item.location_id %>"><%= item.location %></a></td>
            <td><a href="/urzadzenia?location_id=<%= item.location_id %>"><%= item.total %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="section-title">Ostatnia aktywność</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Data</th><th>Zdarzenie</th><th>Urządzenie</th><th>Szczegóły</th><th>Wykonał</th></tr></thead>
    <tbody>
      <% if (recentHistory.length === 0) { %>
        <tr><td colspan="5" class="empty-state">Brak aktywności.</td></tr>
      <% } %>
      <% recentHistory.forEach(h => { %>
        <tr>
          <td class="muted"><%= h.created_at %></td>
          <td><%= h.event %></td>
          <td><a href="/urzadzenia/<%= h.device_id %>"><%= h.device || h.serial_number %></a></td>
          <td class="muted"><%= h.details %></td>
          <td class="muted"><%= h.user_name || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
