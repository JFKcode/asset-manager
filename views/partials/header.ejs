<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' – ' : '' %><%= companyName %> | Asset Manager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand">📦 Asset Manager</a>
    <nav class="nav">
      <a href="/urzadzenia">Urządzenia</a>
      <a href="/pracownicy">Pracownicy</a>
      <a href="/raporty">Raporty</a>
      <a href="/protokoly">Protokoły</a>
      <a href="/protokoly/wydanie/nowy" class="nav-cta">+ Wydanie</a>
      <a href="/protokoly/zdanie/nowy" class="nav-cta nav-cta-alt">+ Zdanie</a>
      <% if (currentUser.role === 'admin') { %><a href="/uzytkownicy">Użytkownicy</a><% } %>
    </nav>
    <div class="user-box">
      <span><%= currentUser.full_name || currentUser.username %></span>
      <form method="POST" action="/logout" style="display:inline">
        <button class="link-btn" type="submit">Wyloguj</button>
      </form>
    </div>
  </div>
</header>
<% } %>
<main class="container">
