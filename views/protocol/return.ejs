<%- include('../partials/header', { title: 'Protokół zdania' }) %>
<div class="page-header"><h1>Protokół zdania sprzętu</h1></div>

<% if (assignments.length === 0) { %>
  <div class="card empty-state">Brak aktywnych przypisań sprzętu do zdania.</div>
<% } else { %>
<form method="POST" action="/protokoly/zdanie" id="returnForm">
  <div class="card">
    <div class="form-grid">
      <div class="field full">
        <label>Wybierz przypisanie do zamknięcia</label>
        <select name="assignment_id" required>
          <option value="">-- wybierz --</option>
          <% assignments.forEach(a => { %>
            <option value="<%= a.id %>">
              <%= a.person %> (<%= a.department || '-' %>) — <%= a.device || 'urządzenie' %> / <%= a.serial_number || 'brak S/N' %> — wydano: <%= a.data_wydania %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label>Data zdania</label>
        <input type="date" name="data_zdania" value="<%= new Date().toISOString().slice(0,10) %>">
      </div>
      <div class="field">
        <label>E-mail do wysyłki (opcjonalnie)</label>
        <input type="email" name="email_override" placeholder="pozostaw puste, aby użyć e-maila pracownika">
      </div>
    </div>
    <div class="field checkbox-row" style="margin-top:6px;">
      <input type="checkbox" id="send_email" name="send_email" value="1" checked>
      <label for="send_email" style="margin:0">Wyślij protokół PDF na e-mail po podpisaniu</label>
    </div>
  </div>

  <div class="card">
    <div class="form-grid">
      <div>
        <div class="sig-label">Podpis pracownika (zdającego)</div>
        <div class="sig-wrap"><canvas id="sigPerson"></canvas></div>
        <div class="sig-actions"><button id="clearPerson" class="btn btn-sm btn-secondary">Wyczyść</button></div>
        <input type="hidden" name="signature_person" id="sigPersonInput">
      </div>
      <div>
        <div class="sig-label">Podpis odbierającego (IT/HR)</div>
        <div class="sig-wrap"><canvas id="sigIssuer"></canvas></div>
        <div class="sig-actions"><button id="clearIssuer" class="btn btn-sm btn-secondary">Wyczyść</button></div>
        <input type="hidden" name="signature_issuer" id="sigIssuerInput">
      </div>
    </div>
    <p class="muted" style="margin-top:10px;">Wskazówka: na tablecie podpisz się palcem lub rysikiem bezpośrednio w polu powyżej.</p>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn">Zapisz i wygeneruj protokół</button>
    <a href="/" class="btn btn-secondary">Anuluj</a>
  </div>
</form>

<script src="/js/signature.js"></script>
<script>
  initSignaturePad('sigPerson', 'sigPersonInput', 'clearPerson');
  initSignaturePad('sigIssuer', 'sigIssuerInput', 'clearIssuer');
</script>
<% } %>
<%- include('../partials/footer') %>
